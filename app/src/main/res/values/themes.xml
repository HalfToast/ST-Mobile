<resources>
    <style name="Theme.StMobile" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#18181B</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.StMobile.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#18181B</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_pulse</item>
        <item name="windowSplashScreenAnimationDuration">1000</item>
        <item name="postSplashScreenTheme">@style/Theme.StMobile</item>
    </style>
</resources>
