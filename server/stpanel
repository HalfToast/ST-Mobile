# ------------------------------------------------------------------------------
# Whitelist (config.yaml, edited with SillyTavern's own yaml package)
# ------------------------------------------------------------------------------

# Four decimal octets 0-255, no leading zeros.
is_ipv4() {
    local IFS=. o
    case "$1" in ''|*[!0-9.]*|.*|*.|*..*) return 1 ;; esac
    # shellcheck disable=SC2086
    set -- $1
    [ $# -eq 4 ] || return 1
    for o in "$@"; do
        case "$o" in 0) ;; 0*) return 1 ;; esac
        [ ${#o} -le 3 ] && [ "$o" -le 255 ] || return 1
    done
}

# Hex groups of up to 4 digits separated by colons: 8 groups, or fewer with one "::".
is_ipv6() {
    local IFS=: g groups=0 compressed=0
    case "$1" in ''|*[!0-9A-Fa-f:]*|*:::*) return 1 ;; esac
    case "$1" in *:*:*) ;; *) return 1 ;; esac
    case "$1" in
        *::*)
            compressed=1
            case "${1#*::}" in *::*) return 1 ;; esac
            ;;
    esac
    case "$1" in ::*) ;; :*) return 1 ;; esac
    case "$1" in *::) ;; *:) return 1 ;; esac
    # shellcheck disable=SC2086
    set -- $1
    for g in "$@"; do
        [ -z "$g" ] && continue
        [ ${#g} -le 4 ] || return 1
        groups=$((groups + 1))
    done
    if [ "$compressed" -eq 1 ]; then
        [ "$groups" -le 7 ]
    else
        [ "$groups" -eq 8 ]
    fi
}

# An IPv4 or IPv6 address with an optional /prefix (at most 32 or 128).
valid_whitelist_address() {
    local addr=$1 prefix="" max
    case "$1" in
        */*/*) return 1 ;;
        */*)
            addr=${1%/*}
            prefix=${1#*/}
            case "$prefix" in ''|*[!0-9]*) return 1 ;; esac
            [ ${#prefix} -le 3 ] || return 1
            ;;
    esac
    if is_ipv4 "$addr"; then
        max=32
    elif is_ipv6 "$addr"; then
        max=128
    else
        return 1
    fi
    [ -z "$prefix" ] || [ $((10#$prefix)) -le "$max" ]
}

# Reads its action and value from the environment (STPANEL_WL_ACTION = show | toggle | mode | add,
# STPANEL_WL_VALUE), never from its source.
WHITELIST_JS='
const fs = require("fs");
const env = process.env;
const paint = (code, text) => (env.STPANEL_COLOR === "1" ? "\x1b[" + code + "m" + text + "\x1b[0m" : text);
const fail = (msg) => { console.error("stpanel: " + msg); process.exit(1); };
let yaml;
try {
    yaml = require(env.STPANEL_YAML);
} catch (e) {
    fail("the yaml package was not found in " + env.STPANEL_YAML + " (run npm install in the SillyTavern folder)");
}
const p = env.STPANEL_CONFIG;
let raw;
try {
    raw = fs.readFileSync(p, "utf8");
} catch (e) {
    fail("cannot read " + p);
}
const doc = yaml.parseDocument(raw);
if (doc.errors && doc.errors.length) fail("config.yaml could not be read as YAML; nothing was changed");
const save = () => fs.writeFileSync(p, String(doc), "utf8");
const restartNote = "(Note: Restart SillyTavern for config changes to take effect)";
const plain = (item) => String(item && typeof item === "object" && "value" in item ? item.value : item);

switch (env.STPANEL_WL_ACTION) {
case "show": {
    const list = doc.toJS() || {};
    console.log(paint("1", "Whitelist Mode:"), list.whitelistMode ? paint("1;32", "ENABLED (Enforcing Allowed IPs)") : paint("1;33", "DISABLED (Open Access)"));
    console.log(paint("1", "Currently Allowed IPs / Subnets:"));
    (Array.isArray(list.whitelist) ? list.whitelist : []).forEach((ip, idx) => console.log("  [" + (idx + 1) + "] " + ip));
    break;
}
case "toggle": {
    const next = !doc.get("whitelistMode");
    doc.set("whitelistMode", next);
    save();
    console.log(paint("1;32", "✓ Whitelist Mode toggled to:"), next ? "ENABLED" : "DISABLED");
    console.log(restartNote);
    break;
}
case "mode": {
    const on = env.STPANEL_WL_VALUE === "on";
    doc.set("whitelistMode", on);
    save();
    console.log(paint("1;32", "✓ Whitelist Mode set to:"), on ? "ENABLED" : "DISABLED");
    console.log(restartNote);
    break;
}
case "add": {
    const ip = env.STPANEL_WL_VALUE;
    const wl = doc.get("whitelist");
    if (wl == null) {
        doc.set("whitelist", doc.createNode([ip]));
    } else if (!Array.isArray(wl.items)) {
        fail("whitelist in config.yaml is not a list; nothing was changed");
    } else if (wl.items.some((item) => plain(item) === ip)) {
        console.log(ip + " is already in the whitelist.");
        break;
    } else {
        wl.add(ip);
    }
    save();
    console.log(paint("1;32", "✓ Added " + ip + " to whitelist!"));
    console.log(restartNote);
    break;
}
default:
    fail("unknown whitelist action");
}
'

# whitelist_node <action> [value]
whitelist_node() {
    STPANEL_WL_ACTION="$1" STPANEL_WL_VALUE="$2" STPANEL_COLOR="$USE_COLOR" \
        STPANEL_YAML="$ST_DIR/node_modules/yaml" STPANEL_CONFIG="$CONFIG_FILE" \
        node -e "$WHITELIST_JS"
}

whitelist_add() {
    if ! valid_whitelist_address "$1"; then
        echo "stpanel: not an IP address or CIDR subnet (e.g. 192.168.1.20 or 192.168.1.0/24); nothing was changed" >&2
        return 1
    fi
    whitelist_node add "$1"
}

# The interactive manager: stdin answers 1 (toggle mode) or 2 then an address (add).
whitelist_manager() {
    local wl_opt new_ip rc=0
    cls
    find_node || { wait_for_enter; return 1; }
    echo -e "${CLR_BOLD}${CLR_CYAN}=== IP Whitelist Manager (config.yaml) ===${CLR_RESET}\n"
    whitelist_node show || { wait_for_enter; return 1; }
    echo ""
    echo -e " ${CLR_CYAN}[1]${CLR_RESET} Toggle Whitelist Mode (ON/OFF)"
    echo -e " ${CLR_CYAN}[2]${CLR_RESET} Add an IP / Subnet to Whitelist"
    echo -e " ${CLR_CYAN}[Enter]${CLR_RESET} Return to Control Panel"
    echo ""
    echo -en "Select option: "
    read -r wl_opt
    case "$wl_opt" in
        1)
            whitelist_node toggle
            rc=$?
            ;;
        2)
            echo -en "Enter IP address or CIDR subnet to add (e.g. 192.168.1.20): "
            read -r new_ip
            [ -n "$new_ip" ] || return 0
            whitelist_add "$new_ip"
            rc=$?
            ;;
        *)
            return 0
            ;;
    esac
    [ "$IS_SUBCOMMAND" = "1" ] || sleep 2
    return $rc
}

# stpanel whitelist [mode on|off | add <address>]
whitelist_command() {
    case "$1" in
        "")
            whitelist_manager
            ;;
        mode)
            case "$2" in
                on|off) find_node && whitelist_node mode "$2" ;;
                *) echo "Usage: stpanel whitelist mode on|off" >&2; return 1 ;;
            esac
            ;;
        add)
            [ $# -eq 2 ] || { echo "Usage: stpanel whitelist add <address>" >&2; return 1; }
            find_node && whitelist_add "$2"
            ;;
        *)
            echo "Usage: stpanel whitelist [mode on|off | add <address>]" >&2
            return 1
            ;;
    esac
}

render_dashboard() {
    local pid cpu mem rss etime ram_mb port lan_ip ts_ip net_data
    local bat_str disk_info ram_info sys_data
    local chars chats worlds personas backups cache_size asset_data
    local branch commit commit_msg git_data
    local http_code latency health_str last_log wl_mode wl_count

    pid=$(get_sillytavern_pid)

    # Gather expensive metrics periodically (every 30s) or on initial render / manual refresh
    if [ -z "$CACHED_NET_DATA" ] || [ $(( TICK_COUNT % 6 )) -eq 0 ]; then
        CACHED_NET_DATA=$(get_network_info)
        CACHED_SYS_DATA=$(get_system_info)
        CACHED_ASSET_DATA=$(get_asset_counts)
        CACHED_GIT_DATA=$(get_git_info)
        CACHED_WL_MODE=$(grep -E '^whitelistMode:' "$CONFIG_FILE" 2>/dev/null | awk '{print $2}')
    fi
    TICK_COUNT=$(( TICK_COUNT + 1 ))

    net_data="$CACHED_NET_DATA"
    IFS='|' read -r lan_ip ts_ip port <<< "$net_data"

    sys_data="$CACHED_SYS_DATA"
    IFS='|' read -r bat_str disk_info ram_info <<< "$sys_data"

    asset_data="$CACHED_ASSET_DATA"
    IFS='|' read -r chars chats worlds personas backups cache_size <<< "$asset_data"

    git_data="$CACHED_GIT_DATA"
    IFS='|' read -r branch commit commit_msg behind ahead <<< "$git_data"

    local git_status_badge=""
    local update_opt=""
    if [ -n "$behind" ] && [ "$behind" -gt 0 ] 2>/dev/null; then
        git_status_badge=" ${CLR_YELLOW}${CLR_BOLD}[🔔 Update: +${behind}]${CLR_RESET}"
        update_opt="  ${CLR_YELLOW}${CLR_BOLD}[6]${CLR_RESET} ${CLR_YELLOW}Update (git pull) 🔔${CLR_RESET}   "
    elif [ -n "$ahead" ] && [ "$ahead" -gt 0 ] 2>/dev/null; then
        git_status_badge=" ${CLR_CYAN}[Local: +${ahead}]${CLR_RESET}"
        update_opt="  ${CLR_CYAN}[6]${CLR_RESET} Update (git pull)        "
    else
        git_status_badge=" ${CLR_GREEN}[Up to date]${CLR_RESET}"
        update_opt="  ${CLR_CYAN}[6]${CLR_RESET} Update (git pull)        "
    fi

    # Whitelist & Auth config
    [ "$CACHED_WL_MODE" = "true" ] && wl_mode="${CLR_GREEN}ON${CLR_RESET}" || wl_mode="${CLR_YELLOW}OFF${CLR_RESET}"

    # Values the device doesn't report are left out.
    local bat_part="" disk_part=""
    [ -n "$bat_str" ] && bat_part="        ${CLR_GREEN}🔋 BATTERY:${CLR_RESET} ${CLR_WHITE}${bat_str}${CLR_RESET}"
    [ -n "$disk_info" ] && disk_part=" ${CLR_WHITE}💾 DISK:${CLR_RESET}    ${CLR_WHITE}${disk_info}${CLR_RESET}      "

    cls
    echo -e "${CLR_CYAN}╭──────────────────────────────────────────────────────────────────────────╮${CLR_RESET}"
    echo -e "${CLR_CYAN}│${CLR_RESET}                   ${CLR_BOLD}${CLR_WHITE}🎭  SILLYTAVERN CONTROL CENTER  🎭${CLR_RESET}                    ${CLR_CYAN}│${CLR_RESET}"
    echo -e "${CLR_CYAN}╰──────────────────────────────────────────────────────────────────────────╯${CLR_RESET}"

    if [ -n "$pid" ]; then
        local metrics
        metrics=$(ps -p "$pid" -o %cpu=,%mem=,rss=,etime= 2>/dev/null)
        read -r cpu mem rss etime <<< "$metrics"
        case "$rss" in ''|*[!0-9]*) ram_mb="--" ;; *) ram_mb="$(( rss / 1024 )) MB" ;; esac
        [ -z "$cpu" ] && cpu="0.0"
        [ -z "$etime" ] && etime="--:--"

        # HTTP health check (HEAD request, zero body transfer, follow redirects)
        local http_res
        http_res=$(curl -o /dev/null -I -s -L -w "%{http_code}:%{time_total}" --max-time 1 "http://127.0.0.1:${port}/" 2>/dev/null || echo "FAIL:0")
        http_code=$(echo "$http_res" | cut -d: -f1)
        latency=$(echo "$http_res" | cut -d: -f2)

        if [ "$http_code" = "200" ] || [ "$http_code" = "302" ]; then
            local latency_ms
            latency_ms=$(awk -v l="$latency" 'BEGIN { printf "%.0f ms", l * 1000 }')
            health_str="${CLR_GREEN}HTTP ${http_code} (${latency_ms})${CLR_RESET}"
        else
            health_str="${CLR_RED}Unresponsive (${http_code})${CLR_RESET}"
        fi

        echo -e " ${CLR_GREEN}🟢 STATUS:${CLR_RESET}  ${CLR_BOLD}ONLINE${CLR_RESET} ${CLR_DIM}(PID: ${pid})${CLR_RESET}      ${CLR_MAGENTA}🌿 GIT:${CLR_RESET}    ${CLR_WHITE}${branch}${CLR_RESET} ${CLR_DIM}(${commit})${CLR_RESET}${git_status_badge}"
        echo -e " ${CLR_YELLOW}⚡ UPTIME:${CLR_RESET}  ${CLR_WHITE}${etime}${CLR_RESET}                          ${CLR_RED}❤️ HEALTH:${CLR_RESET} ${health_str}"
        echo -e " ${CLR_CYAN}💻 CPU:${CLR_RESET}     ${CLR_WHITE}${cpu}%${CLR_RESET}   |   ${CLR_BLUE}🧠 RAM:${CLR_RESET} ${CLR_WHITE}${ram_mb}${CLR_RESET}${bat_part}"
        echo -e "${disk_part} ${CLR_GRAY}📁 CACHE:${CLR_RESET}   ${CLR_WHITE}${cache_size}${CLR_RESET}"
    else
        echo -e " ${CLR_RED}🔴 STATUS:${CLR_RESET}  ${CLR_BOLD}${CLR_RED}OFFLINE${CLR_RESET}                      ${CLR_MAGENTA}🌿 GIT:${CLR_RESET}    ${CLR_WHITE}${branch}${CLR_RESET} ${CLR_DIM}(${commit})${CLR_RESET}${git_status_badge}"
        echo -e " ${CLR_YELLOW}⚡ UPTIME:${CLR_RESET}  ${CLR_DIM}--:--${CLR_RESET}                          ${CLR_RED}❤️ HEALTH:${CLR_RESET} ${CLR_RED}Offline${CLR_RESET}"
        echo -e " ${CLR_CYAN}💻 CPU:${CLR_RESET}     ${CLR_DIM}0.0%${CLR_RESET}   |   ${CLR_BLUE}🧠 RAM:${CLR_RESET} ${CLR_DIM}0 MB${CLR_RESET}  ${bat_part}"
        echo -e "${disk_part} ${CLR_GRAY}📁 CACHE:${CLR_RESET}   ${CLR_WHITE}${cache_size}${CLR_RESET}"
    fi

    echo -e "${CLR_GRAY}────────────────────────────────────────────────────────────────────────────${CLR_RESET}"
    echo -e " ${CLR_BOLD}🌐 ACCESS URLS:${CLR_RESET}"
    echo -e "  • ${CLR_BOLD}Localhost:${CLR_RESET}     ${CLR_CYAN}http://127.0.0.1:${port}${CLR_RESET}"
    [ -n "$lan_ip" ] && echo -e "  • ${CLR_BOLD}Local Wi-Fi:${CLR_RESET}   ${CLR_CYAN}http://${lan_ip}:${port}${CLR_RESET}"
    [ -n "$ts_ip" ]  && echo -e "  • ${CLR_BOLD}Tailscale VPN:${CLR_RESET} ${CLR_CYAN}http://${ts_ip}:${port}${CLR_RESET}"
    echo -e "  • ${CLR_BOLD}Whitelist Mode:${CLR_RESET} [${wl_mode}]"

    echo -e "${CLR_GRAY}────────────────────────────────────────────────────────────────────────────${CLR_RESET}"
    echo -e " ${CLR_BOLD}📊 INVENTORY:${CLR_RESET} Characters: ${CLR_BOLD}${CLR_CYAN}${chars}${CLR_RESET} | Chats: ${CLR_BOLD}${CLR_CYAN}${chats}${CLR_RESET} | Worlds: ${CLR_BOLD}${CLR_CYAN}${worlds}${CLR_RESET} | Personas: ${CLR_BOLD}${CLR_CYAN}${personas}${CLR_RESET} | Backups: ${CLR_BOLD}${CLR_CYAN}${backups}${CLR_RESET}"

    # Last client connection
    if [ -f "$ACCESS_LOG" ] && [ -s "$ACCESS_LOG" ]; then
        last_log=$(tail -n 1 "$ACCESS_LOG" 2>/dev/null)
        local log_ts log_ip log_ua
        log_ts=$(echo "$last_log" | awk '{print $1}' | cut -d'T' -f2 | cut -d'.' -f1)
        log_ip=$(echo "$last_log" | awk '{print $2}')
        log_ua=$(echo "$last_log" | cut -d' ' -f3- | cut -c 1-36)
        echo -e " ${CLR_BOLD}👥 LAST CLIENT:${CLR_RESET} ${CLR_WHITE}${log_ip}${CLR_RESET} ${CLR_DIM}(${log_ua})... at ${log_ts} UTC${CLR_RESET}"
    fi

    echo -e "${CLR_GRAY}────────────────────────────────────────────────────────────────────────────${CLR_RESET}"
    echo -e " ${CLR_BOLD}📋 RECENT SERVER LOGS:${CLR_RESET}"
    if [ -f "$LOG_FILE" ] && [ -s "$LOG_FILE" ]; then
        tail -n 3 "$LOG_FILE" 2>/dev/null | while IFS= read -r line; do
            echo -e "  ${CLR_DIM}•${CLR_RESET} $(echo "$line" | cut -c 1-70)"
        done
    else
        echo -e "  ${CLR_DIM}• (No log entries recorded yet)${CLR_RESET}"
    fi

    echo -e "${CLR_CYAN}────────────────────────────────────────────────────────────────────────────${CLR_RESET}"
    echo -e " ${CLR_BOLD}[SERVER CONTROL]${CLR_RESET}             ${CLR_BOLD}[MAINTENANCE & DATA]${CLR_RESET}     ${CLR_BOLD}[MONITOR & LOGS]${CLR_RESET}"
    echo -e "  ${CLR_CYAN}[1]${CLR_RESET} Start Server             ${CLR_CYAN}[7]${CLR_RESET} Quick Backup (tar.gz)   ${CLR_CYAN}[4]${CLR_RESET} Live Console Log"
    echo -e "  ${CLR_CYAN}[2]${CLR_RESET} Stop Server              ${CLR_CYAN}[8]${CLR_RESET} Clean Cache (_cache)    ${CLR_CYAN}[5]${CLR_RESET} Access Log History"
    echo -e "  ${CLR_CYAN}[3]${CLR_RESET} Restart Server           ${CLR_CYAN}[9]${CLR_RESET} Whitelist Manager       ${CLR_CYAN}[0]${CLR_RESET} Character Stats"
    echo -e "${update_opt}${CLR_CYAN}[p]${CLR_RESET} Pause/Resume Timer      ${CLR_CYAN}[r]${CLR_RESET} Refresh Now"
    echo -e "                                                        ${CLR_RED}[q]${CLR_RESET} Quit Panel"
    echo -e "${CLR_CYAN}────────────────────────────────────────────────────────────────────────────${CLR_RESET}"
}

# In terminals narrower than the panel, lines are cut at the edge instead of
# wrapping (terminal auto-wrap off while the panel is drawn).
render_panel() {
    local cols
    cols=$(tput cols 2>/dev/null)
    case "$cols" in ''|*[!0-9]*) cols="${COLUMNS:-80}" ;; esac
    case "$cols" in ''|*[!0-9]*) cols=80 ;; esac
    if [ -t 1 ] && [ "$cols" -lt 76 ]; then
        printf '\033[?7l'
        render_dashboard
        printf '\033[?7h'
    else
        render_dashboard
    fi
}

print_status_oneshot() {
    local pid net_data port lan_ip ts_ip
    local git_data branch commit commit_msg behind ahead git_status_badge
    local sys_data bat_str disk_info ram_info sys_line=""
    pid=$(get_sillytavern_pid)
    net_data=$(get_network_info)
    IFS='|' read -r lan_ip ts_ip port <<< "$net_data"
    git_data=$(get_git_info)
    IFS='|' read -r branch commit commit_msg behind ahead <<< "$git_data"
    sys_data=$(get_system_info)
    IFS='|' read -r bat_str disk_info ram_info <<< "$sys_data"

    if [ -n "$behind" ] && [ "$behind" -gt 0 ] 2>/dev/null; then
        git_status_badge=" ${CLR_YELLOW}${CLR_BOLD}[🔔 Update: +${behind}]${CLR_RESET}"
    elif [ -n "$ahead" ] && [ "$ahead" -gt 0 ] 2>/dev/null; then
        git_status_badge=" ${CLR_CYAN}[Local: +${ahead}]${CLR_RESET}"
    else
        git_status_badge=" ${CLR_GREEN}[Up to date]${CLR_RESET}"
    fi

    if [ -n "$pid" ]; then
        local metrics cpu mem rss etime proc_part=""
        metrics=$(ps -p "$pid" -o %cpu=,%mem=,rss=,etime= 2>/dev/null)
        read -r cpu mem rss etime <<< "$metrics"
        # Left out where ps can't report them (busybox ps has no -p).
        [ -n "$etime" ] && proc_part="$proc_part | Uptime: $etime"
        [ -n "$cpu" ] && proc_part="$proc_part | CPU: ${cpu}%"
        case "$rss" in ''|*[!0-9]*) ;; *) proc_part="$proc_part | RAM: $(( rss / 1024 )) MB" ;; esac
        echo -e "SillyTavern: ${CLR_GREEN}ONLINE${CLR_RESET} (PID: $pid) | Port: ${port}${proc_part} | Git: $branch ($commit)${git_status_badge}"
        echo -e "Access URLs: http://127.0.0.1:${port} $([ -n "$lan_ip" ] && echo "| Wi-Fi: http://${lan_ip}:${port}") $([ -n "$ts_ip" ] && echo "| Tailscale: http://${ts_ip}:${port}")"
    else
        echo -e "SillyTavern: ${CLR_RED}OFFLINE${CLR_RESET} | Port: $port | Git: $branch ($commit)${git_status_badge}"
    fi

    [ -n "$bat_str" ] && sys_line="$sys_line | Battery: $bat_str"
    [ -n "$disk_info" ] && sys_line="$sys_line | Disk: $disk_info"
    [ -n "$ram_info" ] && sys_line="$sys_line | Device RAM: $ram_info"
    [ -n "$sys_line" ] && echo "System: ${sys_line# | }"
    return 0
}

print_urls_oneshot() {
    local net_data lan_ip ts_ip port
    net_data=$(get_network_info)
    IFS='|' read -r lan_ip ts_ip port <<< "$net_data"
    echo -e "Localhost:     http://127.0.0.1:${port}"
    [ -n "$lan_ip" ] && echo -e "Local Wi-Fi:   http://${lan_ip}:${port}"
    [ -n "$ts_ip" ]  && echo -e "Tailscale VPN: http://${ts_ip}:${port}"
    return 0
}

print_help() {
    echo "Usage: stpanel [command]"
    echo ""
    echo "Commands:"
    echo "  (none)       Open the interactive Control Center"
    echo "  status       Display one-line health & metric summary"
    echo "  urls         Print all accessible URLs (Localhost, Wi-Fi, Tailscale)"
    echo "  start        Start SillyTavern in the background"
    echo "  stop         Stop SillyTavern gracefully"
    echo "  restart      Restart SillyTavern server"
    echo "  backup       Create a timestamped tar.gz archive of user data"
    echo "  clean        Clean temporary thumbnails and cache files"
    echo "  whitelist    Open the Whitelist Manager (answers read from stdin)"
    echo "  whitelist mode on|off     Turn whitelist mode on or off"
    echo "  whitelist add <address>   Allow an IP address or CIDR subnet"
    echo "  stats        View character message counts and activity"
    echo "  logs         Follow SillyTavern console logs in real time"
    echo "  access       View incoming client connection history"
    echo "  update       Update SillyTavern from git"
    echo ""
    echo "Environment:"
    echo "  ST_DIR       SillyTavern folder (default: $TERMUX_HOME/SillyTavern"
    echo "               if it exists, else ~/SillyTavern)"
    echo "  ST_USER      User folder under data/ (default: default-user)"
}

# Command line subcommands
if [ -n "$1" ]; then
    IS_SUBCOMMAND=1
    case "$1" in
        help|-h|--help)
            print_help
            exit 0
            ;;
        status|-s|--status|urls|url|start|stop|restart|backup|clean|whitelist|stats|logs|access|update)
            require_st_dir || exit 1
            ;;
        *)
            echo "Unknown command: $1. Run 'stpanel help' for available commands." >&2
            exit 1
            ;;
    esac
    case "$1" in
        status|-s|--status) print_status_oneshot ;;
        urls|url) print_urls_oneshot ;;
        start) start_server ;;
        stop) stop_server ;;
        restart) restart_server ;;
        backup) create_backup ;;
        clean) clean_cache ;;
        whitelist) shift; whitelist_command "$@" ;;
        stats) character_stats_browser ;;
        logs) view_logs ;;
        access) view_access_logs ;;
        update) update_sillytavern ;;
    esac
    exit $?
fi

IS_SUBCOMMAND=0
require_st_dir || exit 1
[ -t 1 ] && trap 'printf "\033[?7h"' EXIT

# Interactive loop with auto-refresh
while true; do
    render_panel

    read_start=$SECONDS
    if [ "$PAUSED" -eq 1 ]; then
        echo -en " Select option ${CLR_CYAN}[1-9, 0, p, r, q]${CLR_RESET} ${CLR_YELLOW}[REFRESH PAUSED]${CLR_RESET}: "
        read -r -n 1 key
    else
        echo -en " Select option ${CLR_CYAN}[1-9, 0, p, r, q]${CLR_RESET} ${CLR_DIM}(Auto-refreshes in ${REFRESH_INTERVAL}s)${CLR_RESET}: "
        read -t "$REFRESH_INTERVAL" -n 1 -r key
    fi
    rc=$?
    echo ""
    # End of input: nothing more will be typed. bash 3.2 returns 1 for both a
    # timeout and end of input, so a failed timed read counts as end of input
    # only when it came back before the refresh interval was up.
    if [ "$rc" -ne 0 ]; then
        if [ "$PAUSED" -eq 1 ]; then
            exit 0
        elif [ "$rc" -le 128 ] && [ $(( SECONDS - read_start )) -lt "$REFRESH_INTERVAL" ]; then
            exit 0
        fi
        key=""
    fi

    case "$key" in
        1) start_server; sleep 1.5 ;;
        2) stop_server; sleep 1.5 ;;
        3) restart_server; sleep 1.5 ;;
        4) view_logs ;;
        5) view_access_logs ;;
        6) update_sillytavern ;;
        7) create_backup ;;
        8) clean_cache ;;
        9) whitelist_manager ;;
        0) character_stats_browser ;;
        p|P)
            if [ "$PAUSED" -eq 1 ]; then
                PAUSED=0
                echo -e "${CLR_GREEN}Auto-refresh resumed.${CLR_RESET}"
            else
                PAUSED=1
                echo -e "${CLR_YELLOW}Auto-refresh paused.${CLR_RESET}"
            fi
            sleep 1
            ;;
        r|R)
            CACHED_NET_DATA=""
            CACHED_GIT_DATA=""
            rm -f "${ST_DIR}/.git/.last_fetch_check" 2>/dev/null
            TICK_COUNT=0
            continue
            ;;
        q|Q)
            echo -e "${CLR_GREEN}Exiting Control Center. Goodbye!${CLR_RESET}"
            exit 0
            ;;
        *)
            continue
            ;;
    esac
done
