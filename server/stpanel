# Character activity table. Reads ST_DIR, ST_USER, STPANEL_COLOR (1 = ANSI colours) and
# STPANEL_LIMIT (rows, 0 = all) from the environment; nothing is pasted into the source.
STATS_PY='
import os, json, glob, datetime, re

user_dir = os.path.join(os.environ["ST_DIR"], "data", os.environ.get("ST_USER") or "default-user")
limit = int(os.environ.get("STPANEL_LIMIT") or "0")
color = os.environ.get("STPANEL_COLOR") == "1"

def paint(code, text):
    return "\033[" + code + "m" + text + "\033[0m" if color else text

chars_dir = os.path.join(user_dir, "characters")
chats_dir = os.path.join(user_dir, "chats")
backups_dir = os.path.join(user_dir, "backups")
stats_file = os.path.join(user_dir, "stats.json")

stats = {}
if os.path.exists(stats_file):
    try:
        with open(stats_file) as f:
            raw = json.load(f)
            for k, v in raw.items():
                if isinstance(v, dict):
                    clean = k.replace(".png", "").replace("default_", "").lower()
                    stats[clean] = {
                        "messages": v.get("user_msg_count", 0) + v.get("non_user_msg_count", 0),
                        "words": v.get("user_word_count", 0) + v.get("non_user_word_count", 0),
                        "last_active": v.get("date_last_chat", 0) / 1000 if v.get("date_last_chat") else 0
                    }
    except Exception:
        pass

all_chars = {}
if os.path.exists(chars_dir):
    for f in os.listdir(chars_dir):
        if f.endswith((".png", ".json")):
            name = os.path.splitext(f)[0]
            k = name.lower()
            all_chars[k] = {
                "name": name,
                "messages": stats.get(k, {}).get("messages", 0),
                "words": stats.get(k, {}).get("words", 0),
                "last_active": stats.get(k, {}).get("last_active", 0),
                "latest_file": None
            }

if os.path.exists(backups_dir):
    for bf in os.listdir(backups_dir):
        if bf.startswith("chat_") and bf.endswith(".jsonl"):
            m = re.match(r"^chat_(.+?)_(\d{8}-\d{6})\.jsonl$", bf)
            if m:
                c_slug = m.group(1).replace("_", " ").lower()
                try:
                    ts = datetime.datetime.strptime(m.group(2), "%Y%m%d-%H%M%S").timestamp()
                except Exception:
                    ts = 0
                for k in all_chars:
                    norm_k = k.replace("-", " ").replace("_", " ")
                    if norm_k in c_slug or c_slug in norm_k:
                        if ts > all_chars[k]["last_active"]:
                            all_chars[k]["last_active"] = ts
                            all_chars[k]["latest_file"] = os.path.join(backups_dir, bf)

if os.path.exists(chats_dir):
    for cd in os.listdir(chats_dir):
        k = cd.lower()
        if k in all_chars:
            for jf in glob.glob(os.path.join(chats_dir, cd, "*.jsonl")):
                mtime = os.path.getmtime(jf)
                if mtime > all_chars[k]["last_active"]:
                    all_chars[k]["last_active"] = mtime
                    all_chars[k]["latest_file"] = jf

for v in all_chars.values():
    if v["messages"] == 0 and v["latest_file"] and os.path.exists(v["latest_file"]):
        try:
            with open(v["latest_file"], "rb") as fp:
                lines = sum(1 for _ in fp) - 1
                if lines > 0:
                    v["messages"] = lines
        except Exception:
            pass

sorted_chars = sorted(all_chars.values(), key=lambda x: x["last_active"], reverse=True)
total = len(sorted_chars)
shown = sorted_chars[:limit] if limit > 0 else sorted_chars

if total == 0:
    print("  (No characters found in " + chars_dir + ")")
else:
    rule = paint("0;90", "-" * 62)
    print(paint("1", "%-28s | %-10s | %-16s" % ("Character", "Messages", "Last Active")))
    print(rule)
    for c in shown:
        if c["last_active"] > 0:
            dt_str = datetime.datetime.fromtimestamp(c["last_active"]).strftime("%Y-%m-%d %H:%M")
        else:
            dt_str = paint("2", "Never")
        msgs_str = "%d" % c["messages"] if c["messages"] > 0 else "-"
        print("%-28s | %-10s | %s" % (c["name"][:28], msgs_str, dt_str))
    if len(shown) < total:
        print(rule)
        print(paint("2", "Showing top %d of %d characters (sorted by most recently active)" % (len(shown), total)))
'

